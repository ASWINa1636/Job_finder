# Python bytecode & cache
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/

# PyInstaller build artifacts & distribution binaries (>100MB)
build/
dist/
*.spec

# SQLite database & journal locks
*.sqlite3
*.sqlite3-journal
*.sqlite3-wal
*.sqlite3-shm
!data/.gitkeep

# Matplotlib cache & backups
data/.mplcache/
data/backups/

# Environment & Virtualenvs
.env
.venv/
env/
venv/

# Operating system files
.DS_Store
Thumbs.db
